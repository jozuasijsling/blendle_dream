<ViewSwitcher
    android:id="@+id/view_switcher"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    >

    <ImageView
        android:id="@+id/logo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/blendle_logo_background"
        android:contentDescription="@string/blendle_logo_contentDescription"
        android:src="@drawable/blendle_logo"/>

    <include layout="@layout/blendle_issue"/>

</ViewSwitcher>